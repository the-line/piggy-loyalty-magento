<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <leat>
            <connection>
                <personal_access_token backend_model="Magento\Config\Model\Config\Backend\Encrypted" />
            </connection>
            <queue>
                <calls_per_second>5</calls_per_second>
            </queue>
            <credits>
                <label>Credits</label>
            </credits>
            <order>
                <order_export_enabled>0</order_export_enabled>
                <include_tax_as_charge>1</include_tax_as_charge>
                <include_shipping_as_charge>1</include_shipping_as_charge>
            </order>
            <prepaid_balance>
                <enabled>1</enabled>
                <title>Use Your Prepaid Balance</title>
                <summary_title>Prepaid Balance</summary_title>
                <refund_priority>balance_first</refund_priority>
            </prepaid_balance>
            <giftcard_form>
                <show_form>1</show_form>
                <recipient_email>req</recipient_email>
                <recipient_firstname>opt</recipient_firstname>
                <recipient_lastname>opt</recipient_lastname>
                <sender_message>opt</sender_message>
            </giftcard_form>
        </leat>
    </default>
</config>
